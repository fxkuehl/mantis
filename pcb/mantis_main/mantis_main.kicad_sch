  (text_box "Configuration overview\n======================\n\n             | Wireless(nice!nano) |             Wired(RP2040)\n    Pointing |         ZMK         |         ZMK         |         QMK\n      Device | display  |  [LEDs]  | display  |   LEDs   | display  |   LEDs\n-------------+----------+----------+----------+----------+----------+----------\n     PMW3610 |   1.a    |   4.a    |   3.a    |   2.a    |   ---    |   ---\n             |          |          |          |          |          |\n Cirque(SPI) |   1.b*   |   4.c*   |   ---    |   ---    |   3.b    |   2.c\n             |          |          |          |          |          |\n Cirque(I2C) |   1.c*   |   4.b    |   ---    |   2.b    |   ---    |   2.b\n\n\n*) uses extra 3-pin header with nice!nano"
    (at 21.59 275.59 0) (size 135.89 53.34)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (face "Courier 10 Pitch") (size 2 2)) (justify left top))
    (uuid ce5c1a25-f9d1-4bc8-b1b7-88f637983869)
  )

  (text "Wired" (at 43.18 152.4 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 1572ae50-52c2-4587-8787-68824d0af4fd)
  )
  (text "Battery" (at 257.81 157.48 0)
    (effects (font (size 1.27 1.27)) (justify right bottom))
    (uuid 2134211c-5043-45ec-b52e-a58d3dd0aaf5)
  )
  (text "LED Matrix" (at 252.73 31.75 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 21d78f20-19a7-43ac-901f-17e815f69b4f)
  )
  (text "nice!view connectors" (at 100.33 166.37 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 297f5c33-0e55-45fd-b633-d449b0a9c519)
  )
  (text "SPI" (at 55.88 179.07 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
